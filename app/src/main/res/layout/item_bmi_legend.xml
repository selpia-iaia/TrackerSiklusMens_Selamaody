<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="2dp">
        <View android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_circle_pink" android:backgroundTint="#4FC3F7" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Berat Sangat Rendah" android:textSize="11sp" android:textColor="@color/gray" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BMI &lt; 11.0" android:textSize="11sp" android:textColor="@color/black" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="2dp">
        <View android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_circle_pink" android:backgroundTint="#4DB6AC" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Sangat Kurus" android:textSize="11sp" android:textColor="@color/gray" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BMI 11.0-11.9" android:textSize="11sp" android:textColor="@color/black" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="2dp">
        <View android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_circle_pink" android:backgroundTint="#4CAF50" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Berat Badan Rendah" android:textSize="11sp" android:textColor="@color/black" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BMI 12.0-13.4" android:textSize="11sp" android:textColor="@color/black" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="2dp">
        <View android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="center_vertical" android:background="@drawable/bg_circle_pink" android:backgroundTint="#FFEB3B" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Normal" android:textSize="11sp" android:textColor="@color/gray" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BMI 20.5-26.9" android:textSize="11sp" android:textColor="@color/black" />
    </LinearLayout>

</LinearLayout>
